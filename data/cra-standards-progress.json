{
  "name": "CRA Standards Progress: the ETSI EN 304 vertical series under standardisation request M/606",
  "description": "Per-deliverable status of the ETSI EN 304 6xx vertical Cyber Resilience Act standards, mapped to every Annex III and Annex IV point, with the ETSI work item reference, the work programme status, the approval-procedure date, the permanent published PDF and the public draft repository. Records the Official Journal citation state for each deliverable, which is what decides presumption of conformity under Article 27.",
  "url": "https://cvdportal.com/research/cra-standards-progress",
  "publisher": "CVD Portal, Porta Regulus B.V.",
  "license": "CC BY 4.0",
  "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
  "lastVerified": "2026-09-01",
  "citation": "CVD Portal, \"CRA Standards Progress: the ETSI EN 304 vertical series under standardisation request M/606\", 2026-09-01. https://cvdportal.com/research/cra-standards-progress (CC BY 4.0)",
  "methodology": {
    "kind": "Curated compilation of public primary sources. Not a measurement study.",
    "sources": [
      {
        "label": "ETSI Work Programme work item detail reports",
        "url": "https://portal.etsi.org/webapp/WorkProgram/Report_WorkItem.asp?WKI_ID=",
        "use": "Version, cover date, work item reference, approval status and the Official Journal field. Read one work item per deliverable, because the work item ids are not sequential by deliverable number."
      },
      {
        "label": "ETSI publication directory for the 304 600 to 304 699 block",
        "url": "https://www.etsi.org/deliver/etsi_en/304600_304699/",
        "use": "The permanent version-addressed PDF for each deliverable. A deliverable absent from this directory has no public draft."
      },
      {
        "label": "ETSI CYBER-EUSR open consultation area",
        "url": "https://docbox.etsi.org/CYBER/EUSR/Open/",
        "use": "The consultation copy of each draft. Paths here move as drafts progress, which is why the publication directory is the citable link."
      },
      {
        "label": "ETSI press release, 13 August 2026",
        "url": "https://www.etsi.org/newsroom/press-releases/etsi-launches-approval-process-for-17-european-standards-supporting-the-cyber-resilience-act/",
        "use": "The announcement that 17 final drafts entered Public Enquiry, and the mid-September to mid-November 2026 closing window."
      },
      {
        "label": "CRA Standards Unlocked, the CEN, CENELEC and ETSI joint programme",
        "url": "https://www.stan4cra.eu/",
        "use": "Which committee holds each Annex III and Annex IV point outside the ETSI series."
      },
      {
        "label": "Regulation (EU) 2024/2847",
        "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32024R2847#art_27",
        "use": "Article 27 attaches presumption of conformity to a reference published in the Official Journal, which is the field this dataset records per deliverable."
      }
    ],
    "resolutionNote": "Two ETSI surfaces describe the same batch at different resolutions and both are correct. The press release states that 17 final drafts are under Public Enquiry. The work programme records a finer per-deliverable status. This dataset carries the per-deliverable status, because a reader checking one product needs the row rather than the aggregate.",
    "harmonisedStandardFlagNote": "Every one of these ETSI work items carries a field labelled Harmonised Standard reading Yes. That field marks a candidate for harmonisation under M/606 and is not a citation. The separate Official Journal field is what records a citation, and it was empty on all 18 deliverables when checked.",
    "copyrightNote": "This dataset carries metadata about the standards and reproduces no clause text. The standards are ETSI copyright. The CC BY 4.0 licence covers this compilation and its annotations.",
    "limitations": [
      "A stage reflects what a public source showed on the verification date. A deliverable may be further along inside ETSI than any public source can show.",
      "A deliverable with no publicly downloadable draft is recorded as a work item with no version, rather than given an inferred stage.",
      "Work item status strings are ETSI's own workflow vocabulary and are reproduced rather than paraphrased."
    ]
  },
